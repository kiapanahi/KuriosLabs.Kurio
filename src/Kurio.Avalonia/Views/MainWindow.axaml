<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KuriousLabs.Kurio.Avalonia.ViewModels"
        xmlns:views="using:KuriousLabs.Kurio.Avalonia.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="KuriousLabs.Kurio.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Kurio - Download Manager"
        Width="1200"
        Height="700">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Add Download" Command="{Binding ShowAddDownloadCommand}" />
                <Separator />
                <MenuItem Header="_Exit" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Downloads" Command="{Binding ShowDownloadsCommand}" />
                <MenuItem Header="_Statistics" Command="{Binding ShowStatisticsCommand}" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_Preferences" Command="{Binding ShowSettingsCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" />
            </MenuItem>
        </Menu>

        <!-- Main Content Area with Side Navigation -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*">
            <!-- Side Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="10">
                    <Button Content="📥 Downloads"
                            Command="{Binding ShowDownloadsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,5" />
                    <Button Content="➕ Add Download"
                            Command="{Binding ShowAddDownloadCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,5" />
                    <Button Content="📊 Statistics"
                            Command="{Binding ShowStatisticsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,5" />
                    <Button Content="⚙️ Settings"
                            Command="{Binding ShowSettingsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,5" />
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="10">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:DownloadListViewModel">
                        <views:DownloadListView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:AddDownloadViewModel">
                        <views:AddDownloadView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SettingsViewModel">
                        <views:SettingsView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:StatisticsViewModel">
                        <views:StatisticsView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <TextBlock Text="{Binding StatusText}" />
        </Border>
    </Grid>

</Window>