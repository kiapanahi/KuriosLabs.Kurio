<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KuriousLabs.Kurio.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="KuriousLabs.Kurio.Avalonia.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel">

    <Design.DataContext>
        <vm:StatisticsViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Spacing="20" MaxWidth="800">
            <TextBlock Text="Download Statistics" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" />

            <!-- Overall Statistics -->
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="20">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" Margin="0,0,0,0">
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                        <TextBlock Text="Total Downloads" Foreground="Gray" />
                        <TextBlock Text="{Binding TotalDownloads}" FontSize="32" FontWeight="Bold" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,15">
                        <TextBlock Text="Active Downloads" Foreground="Gray" />
                        <TextBlock Text="{Binding ActiveDownloads}" FontSize="32" FontWeight="Bold" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,15">
                        <TextBlock Text="Completed Downloads" Foreground="Gray" />
                        <TextBlock Text="{Binding CompletedDownloads}" FontSize="32" FontWeight="Bold"
                                   Foreground="Green" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,15">
                        <TextBlock Text="Failed Downloads" Foreground="Gray" />
                        <TextBlock Text="{Binding FailedDownloads}" FontSize="32" FontWeight="Bold"
                                   Foreground="Red" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Total Data Downloaded" Foreground="Gray" />
                        <TextBlock Text="{Binding TotalDataDownloaded}" FontSize="32" FontWeight="Bold" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Average Speed" Foreground="Gray" />
                        <TextBlock Text="{Binding AverageSpeed}" FontSize="32" FontWeight="Bold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Additional Information -->
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Session Information" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Statistics are calculated from the current session and historical data."
                               Foreground="Gray" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>