{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "KuriousLabs.Kurio": "Trace"
    }
  },
  "Kurio": {
    "Server": {
      "AllowedOrigins": [
        "http://localhost:5173",
        "http://localhost:3000",
        "http://localhost:8080",
        "https://localhost:5001"
      ],
      "CorsPolicy": "AllowWebClients",
      "EnableSwagger": true
    }
  }
}
